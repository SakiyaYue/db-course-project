digraph ER {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="Arial", fontsize=21, labelloc=t, label="v1.0 TARGET DESIGN - NOT INSTALLED\nSolid: existing FK | Dashed: logical association | Blue: new table"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#64748b", arrowsize=0.7];
Employee [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.Employee</B></FONT></TD></TR><TR><TD ALIGN="LEFT">employee_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">salary</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">NVARCHAR(20)</TD></TR></TABLE>>];
DutyRoster [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.DutyRoster</B></FONT></TD></TR><TR><TD ALIGN="LEFT">duty_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">employee_id [UK/FK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">start_time [UK]</TD><TD ALIGN="LEFT">DATETIME2(0)</TD></TR><TR><TD ALIGN="LEFT">end_time</TD><TD ALIGN="LEFT">DATETIME2(0)</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">UK(employee_id, start_time)</FONT></TD></TR></TABLE>>];
Member [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.Member</B></FONT></TD></TR><TR><TD ALIGN="LEFT">member_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">phone [UK]</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">points</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
SalesOrder [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.SalesOrder</B></FONT></TD></TR><TR><TD ALIGN="LEFT">order_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">member_id [FK]</TD><TD ALIGN="LEFT">VARCHAR(10) ?</TD></TR><TR><TD ALIGN="LEFT">guest_id</TD><TD ALIGN="LEFT">UNIQUEIDENTIFIER ?</TD></TR><TR><TD ALIGN="LEFT">order_time</TD><TD ALIGN="LEFT">DATETIME2(0)</TD></TR><TR><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">NVARCHAR(20)</TD></TR></TABLE>>];
PrincipalBinding [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>teabar_auth.PrincipalBinding</B></FONT></TD></TR><TR><TD ALIGN="LEFT">principal_sid [PK]</TD><TD ALIGN="LEFT">VARBINARY(85)</TD></TR><TR><TD ALIGN="LEFT">principal_name [UK]</TD><TD ALIGN="LEFT">SYSNAME</TD></TR><TR><TD ALIGN="LEFT">member_id [FK]</TD><TD ALIGN="LEFT">VARCHAR(10) ?</TD></TR><TR><TD ALIGN="LEFT">guest_id</TD><TD ALIGN="LEFT">UNIQUEIDENTIFIER ?</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BIT</TD></TR></TABLE>>];
WebAccount [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#1d4ed8"><FONT COLOR="white"><B>teabar_auth.WebAccount</B></FONT></TD></TR><TR><TD ALIGN="LEFT">account_id [PK]</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">login_name [UK]</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">NVARCHAR(512)</TD></TR><TR><TD ALIGN="LEFT">app_role</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">principal_sid [UK]</TD><TD ALIGN="LEFT">VARBINARY(85)</TD></TR><TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BIT</TD></TR><TR><TD ALIGN="LEFT">session_version</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">SID unique; no FK to system catalogs</FONT></TD></TR></TABLE>>];
Employee -> DutyRoster [label="employee_id", taillabel="1", headlabel="0..N", labeldistance=2];
Member -> SalesOrder [label="member_id", taillabel="0..1", headlabel="0..N", labeldistance=2];
Member -> PrincipalBinding [label="member_id", taillabel="0..1", headlabel="0..N", labeldistance=2];
WebAccount -> PrincipalBinding [style=dashed, color="#0d9488", fontcolor="#0f766e", label="SID match: 0..1 each; buyers only; NOT FK", constraint=false];
DutyRoster -> SalesOrder [style=dashed, color="#0d9488", fontcolor="#0f766e", label="0..N : 0..N; order_time within duty interval", constraint=false];
PrincipalBinding -> SalesOrder [style=dashed, color="#0d9488", fontcolor="#0f766e", label="0..N : 0..N; ownership check; NOT FK", constraint=false];
}
