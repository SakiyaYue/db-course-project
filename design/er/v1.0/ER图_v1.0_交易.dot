digraph ER {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, fontname="Arial", fontsize=21, labelloc=t, label="v1.0 TARGET DESIGN - NOT INSTALLED\nSolid: existing FK | Dashed: logical association | Blue: new table"];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#64748b", arrowsize=0.7];
Member [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.Member</B></FONT></TD></TR><TR><TD ALIGN="LEFT">member_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">phone [UK]</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">points</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
SalesOrder [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.SalesOrder</B></FONT></TD></TR><TR><TD ALIGN="LEFT">order_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">member_id [FK]</TD><TD ALIGN="LEFT">VARCHAR(10) ?</TD></TR><TR><TD ALIGN="LEFT">guest_id</TD><TD ALIGN="LEFT">UNIQUEIDENTIFIER ?</TD></TR><TR><TD ALIGN="LEFT">order_time</TD><TD ALIGN="LEFT">DATETIME2(0)</TD></TR><TR><TD ALIGN="LEFT">total_amount</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">NVARCHAR(20)</TD></TR></TABLE>>];
Product [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.Product</B></FONT></TD></TR><TR><TD ALIGN="LEFT">product_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">base_price</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">NVARCHAR(200) ?</TD></TR></TABLE>>];
Specification [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.Specification</B></FONT></TD></TR><TR><TD ALIGN="LEFT">spec_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">spec_type [UK]</TD><TD ALIGN="LEFT">NVARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">spec_name [UK]</TD><TD ALIGN="LEFT">NVARCHAR(20)</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">UK(spec_type, spec_name)</FONT></TD></TR></TABLE>>];
Ingredient [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.Ingredient</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ingredient_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">ingredient_name</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">unit</TD><TD ALIGN="LEFT">NVARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">stock</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">NVARCHAR(10)</TD></TR></TABLE>>];
OrderItem [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.OrderItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT">item_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">order_id [FK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">product_id [FK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">product_name_snapshot</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">base_price_snapshot</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">unit_price</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">sub_amount [computed]</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">Computed subtotal: documented NF exception</FONT></TD></TR></TABLE>>];
AddOn [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.AddOn</B></FONT></TD></TR><TR><TD ALIGN="LEFT">addon_id [PK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">addon_name [UK]</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">ingredient_id [FK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">extra_amount</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">NVARCHAR(10)</TD></TR></TABLE>>];
ItemSpec [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.ItemSpec</B></FONT></TD></TR><TR><TD ALIGN="LEFT">item_id [PK/FK/CK-derived]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">spec_type [PK/FK]</TD><TD ALIGN="LEFT">NVARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">spec_id [FK/CK-derived]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">spec_name_snapshot</TD><TD ALIGN="LEFT">NVARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">price_delta_snapshot</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">3NF; derived key: item_id + spec_id</FONT></TD></TR></TABLE>>];
ItemAddOn [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.ItemAddOn</B></FONT></TD></TR><TR><TD ALIGN="LEFT">item_id [PK/FK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">addon_id [PK/FK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">addon_name_snapshot</TD><TD ALIGN="LEFT">NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">price_snapshot</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR></TABLE>>];
OrderItemIngredient [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#0f172a"><FONT COLOR="white"><B>dbo.OrderItemIngredient</B></FONT></TD></TR><TR><TD ALIGN="LEFT">item_id [PK/FK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">ingredient_id [PK/FK]</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR></TABLE>>];
Member -> SalesOrder [label="member_id", taillabel="0..1", headlabel="0..N", labeldistance=2];
SalesOrder -> OrderItem [label="order_id; minimum by process", taillabel="1", headlabel="1..N", labeldistance=2];
Product -> OrderItem [label="product_id", taillabel="1", headlabel="0..N", labeldistance=2];
Ingredient -> AddOn [label="ingredient_id", taillabel="1", headlabel="0..N", labeldistance=2];
OrderItem -> ItemSpec [label="item_id; required types by process", taillabel="1", headlabel="0..3", labeldistance=2];
Specification -> ItemSpec [label="spec_id, spec_type", taillabel="1", headlabel="0..N", labeldistance=2];
OrderItem -> ItemAddOn [label="item_id", taillabel="1", headlabel="0..N", labeldistance=2];
AddOn -> ItemAddOn [label="addon_id", taillabel="1", headlabel="0..N", labeldistance=2];
OrderItem -> OrderItemIngredient [label="item_id; minimum by process", taillabel="1", headlabel="1..N", labeldistance=2];
Ingredient -> OrderItemIngredient [label="ingredient_id", taillabel="1", headlabel="0..N", labeldistance=2];
}
