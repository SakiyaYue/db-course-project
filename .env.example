# 复制为 .env 后按本机情况修改；.env 不要提交到仓库。
# 本机实例是"仅 Windows 身份验证"，因此使用 Trusted_Connection=yes。
TEABAR_DB_DRIVER=ODBC Driver 18 for SQL Server
TEABAR_DB_SERVER=localhost
TEABAR_DB_NAME=TeabarDB_Phase2_Work
TEABAR_DB_TRUSTED=yes
# 仅当实例启用混合认证且已创建 SQL 登录时才填写：
# TEABAR_DB_USER=teabar_web
# TEABAR_DB_PASSWORD=change-me

# Flask 会话签名密钥：生产/演示请改成随机值（python -c "import secrets;print(secrets.token_urlsafe(48))"）
TEABAR_SECRET_KEY=dev-only-change-me
TEABAR_SESSION_COOKIE_SECURE=0
